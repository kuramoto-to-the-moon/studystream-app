{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyDot",
  "version": "0.0.1-beta.1",
  "identifier": "app.studydot.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES/APACHE-2.0.txt",
      "../THIRD_PARTY_LICENSES/BGE-MIT.txt",
      "../THIRD_PARTY_LICENSES/DEPENDENCIES.txt",
      "../THIRD_PARTY_LICENSES/FONTS-OFL-1.1.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Study streaming control and OBS overlay",
    "longDescription": "A local-first study timer, streaming control and OBS browser-source overlay.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
